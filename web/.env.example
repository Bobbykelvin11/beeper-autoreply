# Required in production: random string (32+ chars) used to encrypt the sign-in cookie.
SESSION_KEY=
# Optional: fixed server URL (Tailscale Funnel / named Cloudflare tunnel). If empty, the page finds the
# server's current quick-tunnel URL through the encrypted ntfy rendezvous.
VM_URL=
# Optional: ntfy server used for the rendezvous (default https://ntfy.sh)
NTFY_URL=
