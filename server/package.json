{
  "name": "beeper-autoreply-server",
  "version": "1.0.0",
  "private": true,
  "description": "AI auto-reply worker for Beeper Server (approve-before-send or fully automatic).",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@beeper/desktop-api": "^6.0.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "@types/ws": "^8.18.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
