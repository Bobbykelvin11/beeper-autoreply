# Copy to /etc/beeper-autoreply.env on the VM (cloud-init writes it for you).
# Long random secret you choose. You type it into the control page to sign in. Never share it.
CONTROL_SECRET=
# Port the control API listens on (localhost only; the tunnel exposes it).
PORT=8787
# Where state (settings, drafts, logs, Beeper token) is stored.
DATA_DIR=/var/lib/beeper-autoreply
# Optional: fixed public URL (Tailscale Funnel / named Cloudflare tunnel). Leave empty for quick tunnel discovery.
PUBLIC_URL=
# Cloudflare quick tunnel metrics address (cloud-init starts cloudflared with --metrics on this address).
CLOUDFLARED_METRICS=127.0.0.1:20241
# Encrypted rendezvous so the control page can find a changing quick-tunnel URL (set to "off" to disable).
NTFY_URL=https://ntfy.sh
# Optional override; otherwise read from ~/.beeper/targets/server.json
BEEPER_BASE_URL=
# Optional AI defaults (can also be set from the control page)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
