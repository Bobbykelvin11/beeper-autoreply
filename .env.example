# Written for you on the VM by setup/gcp-bootstrap.sh or setup/oracle-bootstrap.sh (as /opt/beeper-autoreply/.env, mode 600). Never commit a real .env.
DOMAIN=203-0-113-5.sslip.io
CONTROL_SECRET=your-access-key-12+chars
SESSION_KEY=generated-on-the-vm
# Default AI on the 1 GB e2-micro is Groq (paste the key in the app Settings; do not put it here).
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
# AI_API_KEY=
# Only enable Ollama on a VM with 8 GB+ RAM:
# COMPOSE_PROFILES=ollama
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=qwen2.5:3b
